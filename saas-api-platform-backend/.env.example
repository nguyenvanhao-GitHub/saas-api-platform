# ==============================================================================
# SAAS API PLATFORM BACKEND - NESTJS ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Application & Server
NODE_ENV=development
PORT=3000

# Database Configuration (PostgreSQL 16)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=saas_platform
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=false
DATABASE_SSL=false

# Redis Cache & Token Bucket Rate Limiter
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication (Tối thiểu 32 ký tự)
AUTH_TOKEN_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters_123456
AUTH_REFRESH_SECRET=replace_with_a_secure_random_refresh_token_secret_string_654321
AUTH_TOKEN_TTL_SECONDS=28800

# Mail Server (Mailpit / SMTP)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM="SmartGate Platform" <no-reply@smartgate.vn>

# Object Storage (AWS S3 / MinIO)
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=saas-invoices-storage
STORAGE_S3_ACCESS_KEY=minioadmin
STORAGE_S3_SECRET_KEY=minioadmin
STORAGE_S3_FORCE_PATH_STYLE=true

# VietQR Payment Configuration
VIETQR_BANK_BIN=970422
VIETQR_ACCOUNT_NUMBER=0988889999
VIETQR_ACCOUNT_NAME=CONG TY CP SMARTGATE SOLUTIONS
